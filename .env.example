# Copy to .env (git-ignored) and fill in. Never commit the real file.

# Speech-to-text. Without it nothing transcribes.
SONIOX_API_KEY=

# The live coach and fact extraction. Without it the transcript still records
# and suggestions simply never appear.
ANTHROPIC_API_KEY=

# Optional: point the coach at any OpenAI-compatible endpoint instead.
# COACH_BASE_URL=
# COACH_API_KEY=
# COACH_MODEL=
